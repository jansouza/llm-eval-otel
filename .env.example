# Copy to .env and fill in. .env is in .gitignore: never commit it, it holds the API keys.
#
# llm-eval-judge and tools/benchmark.py read ./.env on their own; variables already set in
# the environment win. The service (llm-eval-otel) reads only the environment: export these,
# or give the container an env_file. Every variable is in docs/configuration.md; the values
# commented out below are the defaults, unless marked as an example.

# =========================================================================================
# Service (llm-eval-otel)
# =========================================================================================

# --- Evaluators -------------------------------------------------------------------------
# Comma-separated. Also available: refusal, system_prompt_leak, output_format, relevance,
# jev_relevance, jev_refusal, jev_toxicity, jev_prompt_injection.
# LLM_EVAL_EVALUATORS=pii_detection,secret_detection
# Types pii_detection reports; the sanitizer always redacts all of them.
# LLM_EVAL_PII_TYPES=cpf,cnpj,email,credit_card,phone,pix_key
# Per-evaluator sample rate (example). relevance samples 5% of traces by default, each
# jev_* check 10%; the heuristics always run on every span.
# LLM_EVAL_SAMPLE_RATES=relevance=0.05,jev_relevance=0.1,jev_refusal=0.1
# Services exempted from some evaluators (example): results are "exempt", with no score.
# LLM_EVAL_EXCEPTIONS='{"bank-chatbot": ["pii_detection", "relevance"]}'
# Association property keys kept off the metrics: per-request values (one series each).
# LLM_EVAL_ASSOCIATION_EXCLUDE=correlation_id

# --- Ingestion (OTLP/HTTP from the Collector) -------------------------------------------
# LLM_EVAL_HTTP_PORT=4318
# When set, requires "Authorization: Bearer <token>" from the Collector.
# LLM_EVAL_AUTH_TOKEN=
# TLS in uvicorn when both are set.
# LLM_EVAL_TLS_CERT_FILE=
# LLM_EVAL_TLS_KEY_FILE=
# Maximum request size, after decompression.
# LLM_EVAL_MAX_REQUEST_BYTES=16777216

# --- Processing -------------------------------------------------------------------------
# Queued interactions before answering 429.
# LLM_EVAL_QUEUE_MAX=10000
# LLM_EVAL_WORKERS=4
# Default per-evaluator timeout, in seconds.
# LLM_EVAL_TIMEOUT_S=5
# Deduplication window for spans the Collector resends.
# LLM_EVAL_DEDUP_TTL_S=600
# Seconds to drain the queue and the judge lanes on shutdown.
# LLM_EVAL_DRAIN_TIMEOUT_S=30

# --- Output and logs --------------------------------------------------------------------
# The Collector receiver reserved for evaluator output.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4319
# OTEL_SERVICE_NAME=llm-eval-otel
# Emit an "evaluate {name}" child span per evaluation, besides the event.
# LLM_EVAL_EMIT_SPANS=true
# DEBUG, INFO, WARNING or ERROR. DEBUG logs every request and evaluation.
# LLM_EVAL_LOG_LEVEL=INFO
# Seconds between INFO summary lines; 0 turns them off.
# LLM_EVAL_LOG_SUMMARY_INTERVAL_S=60

# =========================================================================================
# Judges (relevance and the jev_* checks; also llm-eval-judge and tools/benchmark.py)
# =========================================================================================

# --- Every judge ------------------------------------------------------------------------
# Mask PII and credentials before sending; true unless the judge runs on your network.
# LLM_EVAL_JUDGE_REDACT=true

# --- LLM-as-a-Judge (relevance) ---------------------------------------------------------
# Required. Pin a dated model version, not an alias that changes under you.
LLM_EVAL_LLM_JUDGE_MODEL=gpt-5-mini-2025-08-07
# Read by the openai SDK. A local server without auth accepts any value, but it must be set.
OPENAI_API_KEY=sk-...

# Empty = the OpenAI API. Any OpenAI-compatible server, for a judge on your own network:
# LLM_EVAL_LLM_JUDGE_BASE_URL=http://localhost:8000/v1        # vLLM
# LLM_EVAL_LLM_JUDGE_BASE_URL=http://localhost:11434/v1       # Ollama
# LLM_EVAL_LLM_JUDGE_BASE_URL=http://localhost:4000/v1        # LiteLLM
# LLM_EVAL_LLM_JUDGE_BASE_URL=http://localhost:8080/v1        # python tools/fake_judge_server.py

# json_schema (strict), json_object or none, depending on what the server supports.
# LLM_EVAL_LLM_JUDGE_RESPONSE_FORMAT=json_schema
# Sent only when set (examples): reasoning models reject temperature, several servers
# reject the effort.
# LLM_EVAL_LLM_JUDGE_TEMPERATURE=0
# LLM_EVAL_LLM_JUDGE_REASONING_EFFORT=low
# Reasoning tokens count here too; raise it if results end in judge_truncated.
# LLM_EVAL_LLM_JUDGE_MAX_OUTPUT_TOKENS=1024
# false = the explanation is "score=4/5" instead of the judge's own words.
# LLM_EVAL_LLM_JUDGE_EXPLANATION=true

# The llm_judge lane (service only): calls at a time, evaluations waiting before dropping,
# and a token budget (empty = no limit; 200000 is an example).
# LLM_EVAL_LLM_JUDGE_MAX_CONCURRENCY=8
# LLM_EVAL_LLM_JUDGE_QUEUE_MAX=1000
# LLM_EVAL_LLM_JUDGE_TOKENS_PER_MINUTE=200000

# --- Jev-as-a-Judge (jev_relevance, jev_refusal, jev_toxicity, jev_prompt_injection) ----
# Required for any jev_* check. Pin a version, not jev-latest: the thresholds depend on it.
# LLM_EVAL_JEV_JUDGE_MODEL=jev-1.13.0
# Read by typesafe-sdk.
# TYPESAFE_API_KEY=...

# Empty = TypeSafe's API. The fake server: the SDK adds /v1/systemone itself.
# LLM_EVAL_JEV_JUDGE_BASE_URL=http://localhost:8080             # python tools/fake_judge_server.py

# The jev_judge lane (service only): requests at a time (one per span for every check),
# requests waiting before dropping, and a token budget (empty = no limit; 1000000 is an
# example).
# LLM_EVAL_JEV_JUDGE_MAX_CONCURRENCY=16
# LLM_EVAL_JEV_JUDGE_QUEUE_MAX=1000
# LLM_EVAL_JEV_JUDGE_TOKENS_PER_MINUTE=1000000
