# Copy to .env and fill in. .env is in .gitignore: never commit it, it holds the API key.
#
# llm-eval-judge and tools/benchmark.py read ./.env on their own; variables already set in
# the environment win. The service (llm-eval-otel) reads only the environment: export these,
# or give the container an env_file. Every variable is documented in the README.

# --- Judge (relevance) ----------------------------------------------------------------
# Required. Pin a dated model version, not an alias that changes under you.
LLM_EVAL_JUDGE_MODEL=gpt-5-mini-2025-08-07
# Read by the openai SDK. A local server without auth accepts any value, but it must be set.
OPENAI_API_KEY=sk-...

# Empty = the OpenAI API. Any OpenAI-compatible server, for a judge on your own network:
# LLM_EVAL_JUDGE_BASE_URL=http://localhost:8000/v1        # vLLM
# LLM_EVAL_JUDGE_BASE_URL=http://localhost:11434/v1       # Ollama
# LLM_EVAL_JUDGE_BASE_URL=http://localhost:4000/v1        # LiteLLM
# LLM_EVAL_JUDGE_BASE_URL=http://localhost:8080/v1        # python tools/fake_judge_server.py

# json_schema (strict, default), json_object or none, depending on what the server supports.
# LLM_EVAL_JUDGE_RESPONSE_FORMAT=json_schema
# Sent only when set: reasoning models reject temperature, several servers reject the effort.
# LLM_EVAL_JUDGE_TEMPERATURE=0
# LLM_EVAL_JUDGE_REASONING_EFFORT=low
# Reasoning tokens count here too; raise it if results end in judge_truncated.
# LLM_EVAL_JUDGE_MAX_OUTPUT_TOKENS=1024

# Mask PII and credentials before sending; true unless the judge runs on your network.
# LLM_EVAL_JUDGE_REDACT=true
# false = the explanation is "score=4/5" instead of the judge's own words.
# LLM_EVAL_JUDGE_EXPLANATION=true

# --- Service only (llm-eval-otel) -----------------------------------------------------
# LLM_EVAL_EVALUATORS=pii_detection,secret_detection,relevance
# relevance samples 5% of traces by default.
# LLM_EVAL_SAMPLE_RATES=relevance=0.05
# LLM_EVAL_EXCEPTIONS='{"bank-chatbot": ["pii_detection", "relevance"]}'
# LLM_EVAL_JUDGE_MAX_CONCURRENCY=8
# LLM_EVAL_JUDGE_QUEUE_MAX=1000
# LLM_EVAL_JUDGE_TOKENS_PER_MINUTE=200000
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4319
